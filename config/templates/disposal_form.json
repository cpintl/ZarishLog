{
  "formId": "DISP",
  "title": "Disposal Form",
  "description": "Records disposal of expired, damaged, or unusable stock",
  "fields": [
    { "name": "disposalNumber", "type": "text", "auto": "sequence" },
    { "name": "disposalDate", "type": "date", "default": "now" },
    { "name": "warehouseId", "type": "select", "source": "warehouses", "required": true },
    { "name": "disposalMethodCode", "type": "select", "options": ["INCINERATION", "BURIAL", "CHEMICAL", "RECYCLING", "LANDFILL", "RETURN"] },
    { "name": "authorizedBy", "type": "text" },
    { "name": "witnessBy", "type": "text" },
    { "name": "reason", "type": "textarea" },
    { "name": "status", "type": "select", "options": ["draft", "active", "completed"] },
    {
      "name": "items",
      "type": "table",
      "columns": [
        { "name": "productId", "type": "select", "source": "products", "required": true },
        { "name": "batchNumber", "type": "text" },
        { "name": "quantity", "type": "number", "required": true },
        { "name": "unitCost", "type": "number" },
        { "name": "notes", "type": "textarea" }
      ]
    }
  ]
}