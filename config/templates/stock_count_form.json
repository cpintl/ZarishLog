{
  "formId": "STK_CNT",
  "title": "Physical Stock Count Form",
  "description": "Records actual quantities found during a physical inventory count",
  "fields": [
    { "name": "countNumber", "type": "text", "auto": "sequence" },
    { "name": "warehouseId", "type": "select", "source": "warehouses", "required": true },
    { "name": "countDate", "type": "date", "required": true },
    { "name": "countType", "type": "select", "options": ["full", "cycle", "spot", "annual"] },
    { "name": "countedBy", "type": "text" },
    { "name": "verifiedBy", "type": "text" },
    { "name": "notes", "type": "textarea" },
    {
      "name": "items",
      "type": "table",
      "columns": [
        { "name": "sku", "type": "select", "source": "products", "required": true },
        { "name": "locationCode", "type": "text" },
        { "name": "batchNumber", "type": "text" },
        { "name": "expectedQuantity", "type": "number" },
        { "name": "countedQuantity", "type": "number", "required": true }
      ]
    }
  ]
}