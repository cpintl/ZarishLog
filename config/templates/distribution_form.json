{
  "formId": "DIST",
  "title": "Distribution / Delivery Form",
  "description": "Records products distributed to beneficiaries at a distribution point",
  "fields": [
    { "name": "distributionNumber", "type": "text", "auto": "sequence" },
    { "name": "distributionDate", "type": "date", "default": "now" },
    { "name": "programId", "type": "select", "source": "programs", "required": true },
    { "name": "orgLevelId", "type": "select", "source": "org_levels", "required": true },
    { "name": "location", "type": "text" },
    { "name": "beneficiaryCount", "type": "number" },
    { "name": "status", "type": "select", "options": ["draft", "active", "completed", "cancelled"] },
    { "name": "notes", "type": "textarea" },
    {
      "name": "items",
      "type": "table",
      "columns": [
        { "name": "sku", "type": "select", "source": "products", "required": true },
        { "name": "quantityPlanned", "type": "number", "required": true },
        { "name": "batchNumber", "type": "text" }
      ]
    }
  ]
}