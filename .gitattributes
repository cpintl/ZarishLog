# Normalize line endings
* text=auto

# Source and config files: LF
*.go text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.csv text eol=lf
*.xml text eol=lf

# Reference data (glossary, roles) is text too
*.txt text eol=lf

# Generated code is not diffed by default
apps/api/internal/db/*.sql.go linguist-generated=true
apps/api/internal/db/models.go linguist-generated=true
apps/web/public/sw.js linguist-generated=true

# Binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary